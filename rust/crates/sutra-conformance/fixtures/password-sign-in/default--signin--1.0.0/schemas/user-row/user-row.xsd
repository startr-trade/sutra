<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:sutra:user-row"
           xmlns="urn:sutra:user-row"
           elementFormDefault="qualified">
  <xs:simpleType name="UserId">
    <xs:restriction base="xs:string"><xs:maxLength value="64"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PhcHash">
    <xs:restriction base="xs:string"><xs:maxLength value="256"/></xs:restriction>
  </xs:simpleType>
  <xs:element name="UserRow">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="userId"       type="UserId"/>
        <xs:element name="passwordHash" type="PhcHash"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
