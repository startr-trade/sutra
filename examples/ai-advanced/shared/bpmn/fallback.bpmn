<?xml version="1.0" encoding="UTF-8"?>
<!--
  CROSS-PROVIDER FALLBACK. The model channel `fallback-model` lists two candidates: Anthropic
  first, OpenAI second. A candidate that fails transiently (rate-limited, unavailable, timed out:
  the channel's `fallback-on`) hands the call to the next one, inside the same inline call. A
  rejected request (bad key, unknown model) does not fall back: it fails the call.

    startEvent (any JSON on `fallback`)
      then BuildRequest : data task (FEEL) — requestBody := { prompt }
      then AskModel     : channel-call task on `fallback-model` (sync)
      then BuildReply   : data task (FEEL) — responseObject := { text, provider, model }
      then End          : the caller sees WHICH provider answered

  In the `stub` variant the Anthropic candidate goes through the stub's /flaky gate, which answers
  503 while the stub's outage switch is on (its default): the reply then names `openai`. Switch it
  off (POST /control/outage {"on": false} on the stub) and the same request is answered by
  `anthropic`. The `live` variant gates a REAL Anthropic candidate the same way.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:q="urn:sutra:q:1.0"
                  id="Definitions_fallback"
                  targetNamespace="urn:sutra:module:ai-advanced:1.0.0">

  <bpmn:process id="fallback" name="Answer from whichever candidate is up" isExecutable="true">

    <bpmn:extensionElements>
      <q:variables>
        <q:variable name="requestBody" type="object"/>  <!-- what the model channel is sent -->
        <q:variable name="answer" type="object"/>  <!-- the model's whole reply message -->
        <q:variable name="responseObject" type="object"/>  <!-- what the HTTP caller gets back -->
      </q:variables>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start" name="Request received">
      <bpmn:extensionElements>
        <q:source channel="fallback"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="BuildRequest"/>

    <bpmn:serviceTask id="BuildRequest" name="Build the prompt (FEEL)">
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:dataInputAssociation>
        <bpmn:assignment>
          <bpmn:from>{prompt: "In one short sentence, confirm that you received this message."}</bpmn:from>
          <bpmn:to>requestBody</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="BuildRequest" targetRef="AskModel"/>

    <!-- Sync channel (ack-mode: on-complete): the fallback happens inside this one call. -->
    <bpmn:serviceTask id="AskModel" name="Ask the model (two candidates)" implementation="channel:fallback-model">
      <bpmn:extensionElements>
        <q:timeout duration="PT90S"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing>
      <!-- The whole reply message ({ text, toolCalls, finish, usage, provider, model, ... }). -->
      <bpmn:dataOutputAssociation>
        <bpmn:assignment><bpmn:from>payload</bpmn:from><bpmn:to>answer</bpmn:to></bpmn:assignment>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="AskModel" targetRef="BuildReply"/>

    <!-- A structured reply: responseObject, rendered as JSON by mode="native". -->
    <bpmn:serviceTask id="BuildReply" name="Build the reply (FEEL)">
      <bpmn:extensionElements>
        <q:reply mode="native" contentType="application/json"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:dataInputAssociation>
        <bpmn:assignment>
          <bpmn:from>{text: answer.text, provider: answer.provider, model: answer.model}</bpmn:from>
          <bpmn:to>responseObject</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F4" sourceRef="BuildReply" targetRef="End"/>

    <bpmn:endEvent id="End" name="Answer returned"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_fallback">
    <bpmndi:BPMNPlane id="Plane_fallback" bpmnElement="fallback">
      <bpmndi:BPMNShape id="S_Start" bpmnElement="Start"><dc:Bounds x="100" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_BuildRequest" bpmnElement="BuildRequest"><dc:Bounds x="190" y="78" width="110" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_AskModel" bpmnElement="AskModel"><dc:Bounds x="350" y="78" width="110" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_BuildReply" bpmnElement="BuildReply"><dc:Bounds x="510" y="78" width="110" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End" bpmnElement="End"><dc:Bounds x="670" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_F1" bpmnElement="F1"><di:waypoint x="136" y="118"/><di:waypoint x="190" y="118"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F2" bpmnElement="F2"><di:waypoint x="300" y="118"/><di:waypoint x="350" y="118"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F3" bpmnElement="F3"><di:waypoint x="460" y="118"/><di:waypoint x="510" y="118"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F4" bpmnElement="F4"><di:waypoint x="620" y="118"/><di:waypoint x="670" y="118"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
